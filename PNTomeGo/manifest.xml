<!--
    GsoundG — Garmin Connect IQ Audio Content Provider app.

    FINALIZED (task 1.2):
      - id:          shared app UUID that GsoundA uses to resolve this app. This is a SHARED
                     PROTOCOL CONSTANT and MUST stay byte-for-byte identical to
                     GsoundA/.../net/garmin/GsoundAppId.kt (VALUE). Do not change one without
                     the other.
      - version:     semantic app version (MAJOR.MINOR.PATCH). MUST stay in sync with
                     AppVersion.SEMVER in source/Version.mc (the value shown in the watch UI
                     footer); bump both together on a release.
      - minApiLevel: 3.0.0 (Req 1.3).
      - permissions: Communications (web requests + phone app messaging; Req 1.2). Media and
                     background capabilities come with the audio-content-provider-app type.
      - products:    music-capable fenix models (Req 1.3). Product ids below were taken from the
                     installed SDK (connectiq-sdk-lin-9.2.0) device-reference list and sample
                     manifests, NOT guessed. See the comment on <iq:products> for per-id status.
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application
        id="0236dc0a39fd45f09a109f48fc8c7be2"
        type="audio-content-provider-app"
        name="@Strings.AppName"
        entry="GsoundGApp"
        launcherIcon="@Drawables.LauncherIcon"
        version="0.1.0"
        minApiLevel="3.0.0">

        <!--
            Music-capable fenix devices (Req 1.3). Product ids verified against the installed
            SDK (connectiq-sdk-lin-9.2.0):
              fenix 6 Pro family  — verified via doc/resources/device-reference folders:
                fenix6spro, fenix6pro, fenix6xpro.
                NOTE: the spec mentions "fenix6prosolar", but that product id does NOT exist in
                the SDK. The fenix 6 Pro Solar is a hardware variant of the fenix 6 Pro and
                shares the Connect IQ product id "fenix6pro", so it is covered by that entry.
              fenix 8 family      — verified via both device-reference folders AND SDK sample
                manifests: fenix843mm, fenix847mm, fenix8pro47mm, fenix8solar47mm,
                fenix8solar51mm (AMOLED 43/47 mm, Pro 47 mm, Solar 47/51 mm).
        -->
        <iq:products>
            <iq:product id="fenix6spro"/>
            <iq:product id="fenix6pro"/>
            <iq:product id="fenix6xpro"/>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8pro47mm"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fenix8solar51mm"/>
        </iq:products>

        <iq:permissions>
            <iq:uses-permission id="Communications"/>
        </iq:permissions>

        <iq:languages>
        </iq:languages>

        <iq:barrels>
        </iq:barrels>

    </iq:application>
</iq:manifest>
